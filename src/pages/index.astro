---
import { getCollection } from 'astro:content';
import SiteLayout from '../components/SiteLayout.astro';

const [films, pages] = await Promise.all([
  getCollection('films'),
  getCollection('pages'),
]);
const home = pages.find((page) => page.id === 'home');
const sortedFilms = [...films].sort((a, b) => (b.data.year ?? 0) - (a.data.year ?? 0));
const homeFilms = sortedFilms.slice(0, 8);
---

<SiteLayout title={home?.data.title ?? 'Inicio'} description={home?.data.intro}>
  {sortedFilms.length > 0 ? (
    <section class="hero-carousel" aria-label="Películas de Casa Luz Films">
      {sortedFilms.map((film, index) => (
        <article class:list={['hero-slide', index === 0 && 'is-active']} data-slide={index}>
          {film.data.poster && <img class="hero-image" src={film.data.poster} alt="" />}
          <div class="hero-shade"></div>
          <div class="hero-copy">
            <p class="eyebrow">Una película de Casa Luz Films</p>
            <h1>{film.data.title}</h1>
            {film.data.director && <p class="hero-credit">Dirección: {film.data.director}</p>}
            <a class="text-link light-link" href={`/films/${film.id}/`}>Descubrir película <span>↗</span></a>
          </div>
        </article>
      ))}
      {sortedFilms.length > 1 && (
        <div class="carousel-controls">
          <button type="button" data-carousel="previous" aria-label="Película anterior">‹</button>
          <span><span data-carousel-current>01</span> / {String(sortedFilms.length).padStart(2, '0')}</span>
          <button type="button" data-carousel="next" aria-label="Película siguiente">›</button>
        </div>
      )}
    </section>
  ) : (
    <section class="hero-empty">
      <p class="eyebrow">Productora independiente</p>
      <h1>{home?.data.intro || 'Historias que encuentran su luz.'}</h1>
      <a class="text-link light-link" href="/films/">Conoce nuestras películas <span>↗</span></a>
    </section>
  )}

  <div class="home-horizontal" data-home-horizontal>
    <div class="home-horizontal-viewport">
      <div class="home-horizontal-track">
        <section class="home-intro">
          <p class="eyebrow">{home?.data.title ?? 'Casa Luz Films'}</p>
          <p>{home?.data.paragraphs[0] ?? 'Desarrollamos y producimos cine con una mirada propia, abierta al mundo y arraigada en nuestras historias.'}</p>
          <a class="text-link" href="/about/">Ver más <span>↗</span></a>
        </section>

        <section class="home-films" id="films" aria-labelledby="home-films-title">
          <header class="home-films-heading">
            <h2 id="home-films-title">Films</h2>
          </header>
          {homeFilms.length > 0 ? (
            <div class="film-grid">
              {homeFilms.map((film) => (
                <a class="film-card" href={`/films/${film.id}/`}>
                  <div class="film-image">
                    {film.data.poster ? (
                      <img src={film.data.poster} alt="" loading="lazy" />
                    ) : <div class="image-placeholder" aria-hidden="true">CL</div>}
                  </div>
                  <h3>{film.data.title}</h3>
                  <p>{[film.data.format, film.data.duration ? `${film.data.duration} min` : null, film.data.year].filter(Boolean).join(' · ')}</p>
                </a>
              ))}
            </div>
          ) : (
            <p class="empty-state">Nuestra filmografía estará disponible pronto.</p>
          )}
          <a class="text-link home-films-link" href="/films/">Ver toda la filmografía <span>↗</span></a>
        </section>
      </div>
    </div>
  </div>

  <script>
    const slides = [...document.querySelectorAll<HTMLElement>('[data-slide]')];
    let currentSlide = 0;

    function showSlide(index: number) {
      if (!slides.length) return;
      currentSlide = (index + slides.length) % slides.length;
      slides.forEach((slide, slideIndex) => {
        slide.classList.toggle('is-active', slideIndex === currentSlide);
        slide.setAttribute('aria-hidden', String(slideIndex !== currentSlide));
      });
      const counter = document.querySelector('[data-carousel-current]');
      if (counter) counter.textContent = String(currentSlide + 1).padStart(2, '0');
    }

    document.querySelector('[data-carousel="previous"]')?.addEventListener('click', () => {
      showSlide(currentSlide - 1);
    });
    document.querySelector('[data-carousel="next"]')?.addEventListener('click', () => {
      showSlide(currentSlide + 1);
    });

    if (slides.length > 1) {
      window.setInterval(() => {
        if (document.hidden || document.querySelector<HTMLDialogElement>('[data-site-intro]')?.open) return;
        showSlide(currentSlide + 1);
      }, 5000);
    }

    const horizontal = document.querySelector<HTMLElement>('[data-home-horizontal]');
    const films = horizontal?.querySelector<HTMLElement>('.home-films');
    let frame = 0;

    function updateHorizontal() {
      frame = 0;
      if (!horizontal?.classList.contains('is-horizontal')) return;
      const distance = horizontal.offsetHeight - window.innerHeight;
      const progress = Math.min(1, Math.max(0, -horizontal.getBoundingClientRect().top / distance));
      horizontal.style.setProperty('--horizontal-offset', `${-progress * window.innerWidth}px`);
    }

    function requestHorizontalUpdate() {
      if (!frame) frame = requestAnimationFrame(updateHorizontal);
    }

    function configureHorizontal() {
      if (!horizontal) return;
      horizontal.classList.remove('is-horizontal');
      horizontal.style.removeProperty('--horizontal-offset');
      if (window.innerWidth >= 1000) {
        horizontal.classList.add('is-horizontal');
        requestHorizontalUpdate();
      }
    }

    horizontal?.addEventListener('focusin', (event) => {
      if (!horizontal.classList.contains('is-horizontal')) return;
      const target = event.target;
      if (!(target instanceof Node)) return;
      const top = horizontal.getBoundingClientRect().top + window.scrollY;
      if (films?.contains(target)) window.scrollTo(0, top + window.innerHeight);
      else window.scrollTo(0, top);
    });

    configureHorizontal();
    if (window.location.hash === '#films' && horizontal?.classList.contains('is-horizontal')) {
      window.scrollTo(0, horizontal.getBoundingClientRect().top + window.scrollY + window.innerHeight);
    }
    window.addEventListener('resize', configureHorizontal);
    window.addEventListener('scroll', requestHorizontalUpdate, { passive: true });
  </script>
</SiteLayout>
