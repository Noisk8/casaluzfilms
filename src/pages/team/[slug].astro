---
import { getCollection } from 'astro:content';
import SiteLayout from '../../components/SiteLayout.astro';

export async function getStaticPaths() {
  const people = await getCollection('people');
  return people.map((person) => ({ params: { slug: person.id }, props: { person } }));
}

const { person } = Astro.props;
---

<SiteLayout title={person.data.name}>
  <article class="person-page">
    <header class="page-heading person-heading"><h1>{person.data.name}</h1></header>
    <div class="person-portrait">
      {person.data.portrait
        ? <img src={person.data.portrait} alt={person.data.name} />
        : <div class="image-placeholder" aria-hidden="true">CL</div>}
    </div>
    <p class="person-role">{person.data.role}</p>
    <div class="person-bio">
      {person.data.bio.map((paragraph) => <p>{paragraph}</p>)}
    </div>
    {person.data.email && <a class="text-link" href={`mailto:${person.data.email}`}>{person.data.email} <span>↗</span></a>}
    <a class="back-link" href="/team/">← Volver a Team</a>
  </article>
</SiteLayout>
