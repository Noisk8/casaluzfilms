---
import { getCollection } from 'astro:content';
import SiteLayout from '../../components/SiteLayout.astro';

export async function getStaticPaths() {
  const films = await getCollection('films');
  return films.map((film) => ({ params: { slug: film.id }, props: { film } }));
}

const { film } = Astro.props;
const { data } = film;
const { producers = [], coProducers = [], festivals = [], stills = [] } = data;
const galleryImages = stills;
const trailerUrl = data.trailerUrl?.match(/^https:\/\/(www\.)?(youtube\.com\/embed\/|player\.vimeo\.com\/video\/)/)
  ? data.trailerUrl
  : undefined;
---

<SiteLayout title={data.title} description={data.synopsis ?? `${data.title}, película de Casa Luz Films.`}>
  <article class="film-page">
    <header class="page-heading film-page-heading">
      <p class="eyebrow">Película {data.year ? `· ${data.year}` : ''}</p>
      <h1>{data.title}</h1>
    </header>
    {trailerUrl ? (
      <div class="trailer-frame">
        <iframe
          src={trailerUrl}
          title={`Tráiler de ${data.title}`}
          loading="lazy"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
        ></iframe>
      </div>
    ) : data.poster ? (
      <figure class="film-key-art">
        <img src={data.poster} alt={`Imagen provisional de ${data.title}`} />
      </figure>
    ) : null}
    <section class="film-copy">
      {data.synopsis && <p class="film-synopsis">{data.synopsis}</p>}
      <dl class="film-credits">
        {data.status && <div><dt>Estado</dt><dd>{data.status}</dd></div>}
        {data.originalTitle && <div><dt>Título original</dt><dd>{data.originalTitle}</dd></div>}
        {data.format && <div><dt>Formato</dt><dd>{data.format}</dd></div>}
        {data.duration && <div><dt>Duración</dt><dd>{data.duration} min</dd></div>}
        {data.director && <div><dt>Dirección</dt><dd>{data.director}</dd></div>}
        {data.screenwriter && <div><dt>Guion</dt><dd>{data.screenwriter}</dd></div>}
        {producers.length > 0 && <div><dt>Producción</dt><dd>{producers.join(', ')}</dd></div>}
        {coProducers.length > 0 && <div><dt>Coproducción</dt><dd>{coProducers.join(', ')}</dd></div>}
        {data.sales && <div><dt>Ventas</dt><dd>{data.sales}</dd></div>}
      </dl>
      {(data.imdbUrl || data.instagramUrl || data.websiteUrl) && (
        <div class="film-links" aria-label="Enlaces de la película">
          {data.imdbUrl && <a class="text-link" href={data.imdbUrl} target="_blank" rel="noreferrer">IMDb <span>↗</span></a>}
          {data.instagramUrl && <a class="text-link" href={data.instagramUrl} target="_blank" rel="noreferrer">Instagram <span>↗</span></a>}
          {data.websiteUrl && <a class="text-link" href={data.websiteUrl} target="_blank" rel="noreferrer">Sitio oficial <span>↗</span></a>}
        </div>
      )}
    </section>
    {festivals.length > 0 && (
      <section class="film-festivals" aria-labelledby="film-festivals-title">
        <h2 id="film-festivals-title">Festivales y reconocimientos</h2>
        <ul>
          {festivals.map((festival) => <li>{festival}</li>)}
        </ul>
      </section>
    )}
    {galleryImages.length > 0 && (
      <section class="film-gallery" aria-label={`Galería de ${data.title}`} data-film-gallery>
        <div class="film-gallery-stage">
          {galleryImages.map((still, index) => (
            <img
              class:list={['film-gallery-image', index === 0 && 'is-active']}
              src={still}
              alt={`Imagen ${index + 1} de ${data.title}`}
              loading={index === 0 ? 'eager' : 'lazy'}
              data-gallery-image={index}
            />
          ))}
          {galleryImages.length > 1 && <>
            <button class="film-gallery-control is-previous" type="button" aria-label="Imagen anterior" data-gallery-previous>‹</button>
            <button class="film-gallery-control is-next" type="button" aria-label="Imagen siguiente" data-gallery-next>›</button>
          </>}
        </div>
        {galleryImages.length > 1 && (
          <div class="film-gallery-thumbnails" role="tablist" aria-label="Seleccionar imagen">
          {galleryImages.map((still, index) => (
            <button
              class:list={['film-gallery-thumbnail', index === 0 && 'is-active']}
              type="button"
              role="tab"
              aria-label={`Ver imagen ${index + 1}`}
              aria-selected={index === 0 ? 'true' : 'false'}
              data-gallery-thumbnail={index}
            ><img src={still} alt="" loading="lazy" /></button>
          ))}
        </div>
        )}
      </section>
    )}
    <a class="back-link" href="/films/">← Volver a Films</a>
  </article>
  <script>
    document.querySelectorAll<HTMLElement>('[data-film-gallery]').forEach((gallery) => {
      const images = [...gallery.querySelectorAll<HTMLImageElement>('[data-gallery-image]')];
      const thumbnails = [...gallery.querySelectorAll<HTMLButtonElement>('[data-gallery-thumbnail]')];
      if (images.length < 2) return;
      let activeIndex = 0;

      const showImage = (index: number) => {
        activeIndex = (index + images.length) % images.length;
        images.forEach((image, imageIndex) => image.classList.toggle('is-active', imageIndex === activeIndex));
        thumbnails.forEach((thumbnail, thumbnailIndex) => {
          const isActive = thumbnailIndex === activeIndex;
          thumbnail.classList.toggle('is-active', isActive);
          thumbnail.setAttribute('aria-selected', String(isActive));
        });
      };

      gallery.querySelector('[data-gallery-previous]')?.addEventListener('click', () => showImage(activeIndex - 1));
      gallery.querySelector('[data-gallery-next]')?.addEventListener('click', () => showImage(activeIndex + 1));
      thumbnails.forEach((thumbnail, index) => thumbnail.addEventListener('click', () => showImage(index)));
    });
  </script>
</SiteLayout>
