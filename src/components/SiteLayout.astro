---
import '../styles.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Casa Luz Films: historias para la pantalla.' } = Astro.props;
const currentYear = new Date().getFullYear();
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <script is:inline>
      document.documentElement.classList.add('intro-gate');
      try {
        if (sessionStorage.getItem('casaluz-intro-seen-v11') === '1') {
          document.documentElement.classList.add('intro-seen');
        }
      } catch { /* Storage may be unavailable. */ }
    </script>
    <title>{title} · Casa Luz Films</title>
  </head>
  <body class={Astro.url.pathname === '/' ? 'landing-page' : undefined}>
    <dialog class="site-intro" aria-labelledby="site-intro-title" data-site-intro>
      <video
        class="intro-background-video"
        autoplay
        muted
        loop
        playsinline
        preload="auto"
        aria-hidden="true"
      >
        <source src="/video/video_de_fondo%20intro.mp4" type="video/mp4" />
      </video>
      <div class="intro-light" aria-hidden="true"></div>
      <div class="intro-content">
        <h2 id="site-intro-title" class="intro-title">Casa Luz Films</h2>
        <div class="intro-logo" aria-hidden="true">
          <canvas class="intro-logo-particles"></canvas>
          <img class="intro-logo-triangle" src="/images/logos/intro-triangle.svg" alt="" />
          <img class="intro-logo-circle" src="/images/logos/intro-circle.svg" alt="" />
          <img class="intro-logo-text" src="/images/logos/intro-text.svg" alt="" />
          <span class="intro-logo-flare"></span>
        </div>
        <button class="intro-enter" type="button" data-intro-enter disabled>Entrar</button>
      </div>
    </dialog>
    <a class="skip-link" href="#main">Saltar al contenido</a>
    <header class="site-header">
      <a class="wordmark" href="/" aria-label="Casa Luz Films, inicio">
        <img src="/images/logos/logo largo.svg" alt="Casa Luz Films" />
      </a>
      <button
        class="menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="site-menu"
        aria-label="Abrir menú"
      >
        <span></span><span></span><span></span>
      </button>
    </header>
    <nav class="menu-panel" id="site-menu" aria-label="Navegación principal" inert>
      <button class="menu-close" type="button" aria-label="Cerrar menú">×</button>
      <div class="menu-links">
        <a href="/about/">About</a>
        <a href="/fundacion/">Fundación</a>
        <a href="/films/">Films</a>
        <a href="/team/">Team</a>
        <a href="/contact/">Contact</a>
      </div>
    </nav>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="footer-socials" aria-label="Redes sociales">
        <a href="https://www.instagram.com/casaluzfilms/" target="_blank" rel="noreferrer" aria-label="Casa Luz Films en Instagram">
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.8" r="1" class="social-dot"/></svg>
        </a>
        <a href="https://pe.linkedin.com/company/casaluzfilms" target="_blank" rel="noreferrer" aria-label="Casa Luz Films en LinkedIn">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5.4 8.4H2.2V21h3.2V8.4Zm.2-3.9A1.9 1.9 0 1 0 2 4.5a1.9 1.9 0 0 0 3.6 0ZM21.8 21v-6.9c0-3.4-1.8-5-4.3-5-2 0-2.9 1.1-3.4 1.9V9.3h-3.2V21h3.2v-5.8c0-1.5.3-3 2.2-3 1.9 0 1.9 1.8 1.9 3.1V21h3.6Z"/></svg>
        </a>
      </div>
      <p class="footer-copyright">© {currentYear} Casa Luz Films. Todos los derechos reservados.</p>
      <a class="footer-top" href="#main" aria-label="Volver al inicio">↑</a>
    </footer>
    <script>
      const introDialog = document.querySelector<HTMLDialogElement>('[data-site-intro]');
      const enterButton = document.querySelector<HTMLButtonElement>('[data-intro-enter]');
      const introLogo = document.querySelector<HTMLElement>('.intro-logo');
      const introKey = 'casaluz-intro-seen-v11';
      let introSeen = false;
      try { introSeen = sessionStorage.getItem(introKey) === '1'; } catch { /* Storage may be unavailable. */ }

      if (introSeen) document.documentElement.classList.add('intro-seen');

      if (introDialog && !introSeen) {
        introDialog.showModal();
        const finishIntro = () => {
          enterButton?.removeAttribute('disabled');
          introDialog.classList.add('is-ready');
        };
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          introLogo?.classList.add('is-formed');
          finishIntro();
        } else {
          animateIntroLogo().then(finishIntro).catch(() => {
            introLogo?.classList.add('is-formed');
            finishIntro();
          });
        }
      }

      function animateIntroLogo() {
        if (!introLogo) return Promise.reject(new Error('Logo unavailable'));
        introLogo.classList.add('is-assembling');
        return new Promise<void>((resolve) => window.setTimeout(() => {
          introLogo.classList.add('is-complete');
          resolve();
        }, 6200));
      }

      async function assembleIntroLogo() {
        const canvas = introLogo?.querySelector<HTMLCanvasElement>('canvas');
        const images = [...(introLogo?.querySelectorAll<HTMLImageElement>('img') ?? [])];
        const context = canvas?.getContext('2d');
        if (!introLogo || !canvas || !context || images.length !== 3) throw new Error('Logo unavailable');

        await Promise.all(images.map((img) => new Promise<void>((resolve, reject) => {
          if (img.complete) {
            if (img.naturalWidth) resolve();
            else reject(new Error('Logo image unavailable'));
            return;
          }
          img.addEventListener('load', () => resolve(), { once: true });
          img.addEventListener('error', () => reject(new Error('Logo image unavailable')), { once: true });
        })));
        const width = Math.round(introLogo.getBoundingClientRect().width);
        const height = Math.round(introLogo.getBoundingClientRect().height);
        if (!width || !height) throw new Error('Logo has no size');
        const pixelRatio = Math.min(window.devicePixelRatio || 1, 2);
        canvas.width = Math.round(width * pixelRatio);
        canvas.height = Math.round(height * pixelRatio);
        context.setTransform(pixelRatio, 0, 0, pixelRatio, 0, 0);

        const sampleCanvas = document.createElement('canvas');
        sampleCanvas.width = width;
        sampleCanvas.height = height;
        const sampleContext = sampleCanvas.getContext('2d', { willReadFrequently: true });
        if (!sampleContext) throw new Error('Canvas unavailable');

        const glowCanvas = document.createElement('canvas');
        glowCanvas.width = glowCanvas.height = 20;
        const glowContext = glowCanvas.getContext('2d');
        if (!glowContext) throw new Error('Particle texture unavailable');
        const glow = glowContext.createRadialGradient(10, 10, 0, 10, 10, 10);
        glow.addColorStop(0, 'rgba(255, 255, 255, 1)');
        glow.addColorStop(0.24, 'rgba(255, 249, 224, .8)');
        glow.addColorStop(1, 'rgba(255, 235, 187, 0)');
        glowContext.fillStyle = glow;
        glowContext.fillRect(0, 0, 20, 20);

        const stampCanvas = document.createElement('canvas');
        stampCanvas.width = stampCanvas.height = 32;
        const stampContext = stampCanvas.getContext('2d');
        if (!stampContext) throw new Error('Particle stamp unavailable');
        const stamp = stampContext.createRadialGradient(16, 16, 0, 16, 16, 16);
        stamp.addColorStop(0, 'rgba(255, 255, 255, 1)');
        stamp.addColorStop(0.55, 'rgba(255, 255, 255, 1)');
        stamp.addColorStop(1, 'rgba(255, 255, 255, 0)');
        stampContext.fillStyle = stamp;
        stampContext.fillRect(0, 0, 32, 32);

        const masks = images.map(() => {
          const surface = document.createElement('canvas');
          surface.width = width;
          surface.height = height;
          const drawing = surface.getContext('2d');
          if (!drawing) throw new Error('Layer mask unavailable');
          return { surface, drawing };
        });
        const layerSurface = document.createElement('canvas');
        layerSurface.width = width;
        layerSurface.height = height;
        const layerDrawing = layerSurface.getContext('2d');
        if (!layerDrawing) throw new Error('Layer canvas unavailable');

        const particles: Array<{ layer: number; x: number; y: number; startX: number; startY: number; curveX: number; curveY: number; delay: number; duration: number; alpha: number; size: number; drift: number; reveal: number }> = [];
        const starts = [250, 900, 1700];
        const durations = [1900, 1900, 1600];
        images.forEach((img, layer) => {
          sampleContext.clearRect(0, 0, width, height);
          sampleContext.drawImage(img, 0, 0, width, height);
          const pixels = sampleContext.getImageData(0, 0, width, height).data;
          const candidates: Array<{ x: number; y: number; alpha: number }> = [];
          const step = 2;
          for (let y = 0; y < height; y += step) {
            for (let x = 0; x < width; x += step) {
              const alpha = pixels[(y * width + x) * 4 + 3] / 255;
              if (alpha > 0.12) candidates.push({ x: x + Math.random() * step, y: y + Math.random() * step, alpha });
            }
          }
          for (let index = candidates.length - 1; index > 0; index--) {
            const swap = Math.floor(Math.random() * (index + 1));
            [candidates[index], candidates[swap]] = [candidates[swap], candidates[index]];
          }
          const count = Math.min(candidates.length, layer === 2 ? 300 : layer === 1 ? 550 : 450);
          for (let index = 0; index < count; index++) {
            const point = candidates[index];
            const scatter = Math.random();
            const startX = layer === 0 ? point.x - width * (0.55 + scatter * 0.65)
              : layer === 1 ? point.x + width * (0.55 + scatter * 0.65)
              : point.x + (Math.random() - 0.5) * width * 0.7;
            const startY = layer === 0 ? point.y + height * (0.4 + Math.random() * 0.6)
              : layer === 1 ? point.y - height * (0.35 + Math.random() * 0.6)
              : point.y + height * (0.5 + Math.random() * 0.45);
            particles.push({
              ...point, layer, startX, startY,
              curveX: (Math.random() - 0.5) * width * 0.4,
              curveY: (Math.random() - 0.5) * height * 0.22,
              delay: starts[layer] + Math.random() * 260,
              duration: durations[layer] + Math.random() * 180,
              size: 3 + Math.random() * 3,
              drift: Math.random() * Math.PI * 2,
              reveal: 0,
            });
          }
        });

        await new Promise<void>((resolve) => {
          const startTime = performance.now();
          const stampRadius = Math.max(8, width / 24);
          function draw(now: number) {
            const elapsed = now - startTime;
            for (const particle of particles) {
              const progress = Math.min(1, Math.max(0, (elapsed - particle.delay) / particle.duration));
              const settling = Math.min(1, Math.max(0, (progress - 0.68) / 0.32));
              const reveal = settling * settling * (3 - 2 * settling);
              if (reveal <= particle.reveal || particle.reveal >= 1) continue;
              const drawing = masks[particle.layer].drawing;
              drawing.globalAlpha = (reveal - particle.reveal) / (1 - particle.reveal);
              drawing.drawImage(
                stampCanvas,
                particle.x - stampRadius,
                particle.y - stampRadius,
                stampRadius * 2,
                stampRadius * 2,
              );
              drawing.globalAlpha = 1;
              particle.reveal = reveal;
            }
            context!.clearRect(0, 0, width, height);
            images.forEach((img, layer) => {
              layerDrawing!.clearRect(0, 0, width, height);
              layerDrawing!.drawImage(img, 0, 0, width, height);
              layerDrawing!.globalCompositeOperation = 'destination-in';
              layerDrawing!.drawImage(masks[layer].surface, 0, 0);
              layerDrawing!.globalCompositeOperation = 'source-over';
              context!.drawImage(layerSurface, 0, 0);
            });
            for (const particle of particles) {
              if (particle.reveal >= 1) continue;
              const progress = Math.min(1, Math.max(0, (elapsed - particle.delay) / particle.duration));
              if (progress <= 0) continue;
              const ease = progress * progress * (3 - 2 * progress);
              const arc = Math.sin(Math.PI * ease);
              const shimmer = Math.sin(elapsed * 0.009 + particle.drift) * (1 - ease) * 12;
              const x = particle.startX + (particle.x - particle.startX) * ease + particle.curveX * arc + shimmer;
              const y = particle.startY + (particle.y - particle.startY) * ease + particle.curveY * arc - shimmer * 0.45;
              context!.globalAlpha = particle.alpha * Math.min(1, progress * 4) * (1 - particle.reveal);
              context!.drawImage(glowCanvas, x - particle.size / 2, y - particle.size / 2, particle.size, particle.size);
            }
            context!.globalAlpha = 1;
            if (elapsed < 3850) requestAnimationFrame(draw);
            else resolve();
          }
          requestAnimationFrame(draw);
        });

        introLogo.classList.add('is-assembled');
        await new Promise((resolve) => window.setTimeout(resolve, 1100));
      }

      function enterSite() {
        if (!introDialog?.open || introDialog.classList.contains('is-leaving')) return;
        try { sessionStorage.setItem(introKey, '1'); } catch { /* Continue without storage. */ }
        introDialog.classList.add('is-leaving');
        const duration = window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 0 : 900;
        window.setTimeout(() => {
          introDialog.close();
          document.documentElement.classList.add('intro-seen');
          introDialog.classList.remove('is-leaving');
          document.querySelector<HTMLElement>('.wordmark')?.focus();
          startReveals();
        }, duration);
      }

      enterButton?.addEventListener('click', enterSite);
      introDialog?.addEventListener('cancel', (event) => {
        event.preventDefault();
        enterSite();
      });

      let revealsStarted = false;
      function startReveals() {
        if (revealsStarted || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        revealsStarted = true;

        const selectors = [
          '.site-header > *',
          '.hero-slide.is-active .hero-copy > *',
          '.carousel-controls',
          '.hero-empty > *',
          '.home-intro > *',
          '.home-films-heading > *',
          '.home-films .film-card',
          '.home-films > .text-link',
          '.page-heading > *',
          '.about-content > *',
          '.contact-content > *',
          '.contact-content address > *',
          '.catalogue .film-card',
          '.team-grid .person-card',
          '.film-page > .trailer-frame',
          '.film-page > .film-key-art',
          '.film-copy > *',
          '.film-gallery > *',
          '.film-stills > *',
          '.person-page > .person-portrait',
          '.person-page > .person-role',
          '.person-bio > *',
          '.person-page > .text-link',
          '.person-page > .back-link',
        ];
        const targets = [...document.querySelectorAll<HTMLElement>(selectors.join(', '))];
        const groupCounts = new Map<Element, number>();

        targets.forEach((element) => {
          const parent = element.parentElement;
          const index = parent ? (groupCounts.get(parent) ?? 0) : 0;
          if (parent) groupCounts.set(parent, index + 1);
          element.style.setProperty('--reveal-delay', `${Math.min(index * 75, 300)}ms`);
          element.classList.add('reveal-item');
        });

        if (!('IntersectionObserver' in window)) {
          targets.forEach((element) => element.classList.add('is-visible'));
          return;
        }

        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          });
        }, { threshold: 0.06, rootMargin: '0px 0px -8% 0px' });

        requestAnimationFrame(() => targets.forEach((element) => observer.observe(element)));
      }

      if (introSeen) startReveals();

      const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
      const closeButton = document.querySelector<HTMLButtonElement>('.menu-close');
      const menu = document.querySelector<HTMLElement>('.menu-panel');

      function setMenuOpen(open: boolean) {
        if (!toggle || !menu) return;
        toggle.setAttribute('aria-expanded', String(open));
        toggle.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
        menu.inert = !open;
        menu.classList.toggle('is-open', open);
        document.body.classList.toggle('menu-open', open);
        if (open) closeButton?.focus();
        else toggle.focus();
      }

      toggle?.addEventListener('click', () => {
        setMenuOpen(toggle.getAttribute('aria-expanded') !== 'true');
      });
      closeButton?.addEventListener('click', () => setMenuOpen(false));
      menu?.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => setMenuOpen(false));
      });
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') setMenuOpen(false);
      });
    </script>
  </body>
</html>
