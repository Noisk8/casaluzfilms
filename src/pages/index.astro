---
import { getCollection } from 'astro:content';
import SiteLayout from '../components/SiteLayout.astro';

const [films, pages] = await Promise.all([
  getCollection('films'),
  getCollection('pages'),
]);
const home = pages.find((page) => page.id === 'home');
const sortedFilms = [...films].sort((a, b) => (b.data.year ?? 0) - (a.data.year ?? 0));
const homeBanners = [
  '/images/home/home%201.jpg',
  '/images/home/home%202.jpg',
  '/images/home/home%203.jpg',
  '/images/home/home%204.jpg',
  '/images/home/home%205.jpg',
  '/images/home/home%206.jpg',
];
---

<SiteLayout title={home?.data.title ?? 'Inicio'} description={home?.data.intro}>
  <div class="home-horizontal" data-home-horizontal>
    <div class="home-horizontal-viewport">
      <div class="home-horizontal-track">
        {homeBanners.length > 0 ? (
          <section class="hero-carousel home-hero-panel" aria-label="Películas de Casa Luz Films">
            {homeBanners.map((banner, index) => (
              <article class:list={['hero-slide', index === 0 && 'is-active']} data-slide={index}>
                <img class="hero-image" src={banner} alt="" />
                <div class="hero-shade"></div>
              </article>
            ))}
            {homeBanners.length > 1 && (
              <div class="carousel-controls">
                <button type="button" data-carousel="previous" aria-label="Película anterior">‹</button>
                <button type="button" data-carousel="next" aria-label="Película siguiente">›</button>
              </div>
            )}
          </section>
        ) : (
          <section class="hero-empty home-hero-panel">
            <p class="eyebrow">Productora independiente</p>
            <h1>{home?.data.intro || 'Historias que encuentran su luz.'}</h1>
          </section>
        )}

        <section class="home-films catalogue" id="films" aria-labelledby="home-films-title">
          <header class="home-films-heading">
            <h2 id="home-films-title">Films</h2>
          </header>
          {sortedFilms.length ? (
            <div class="film-grid">
              {sortedFilms.map((film) => (
                <a class="film-card" href={`/films/${film.id}/`}>
                  <div class="film-image">
                    {film.data.banner ?? film.data.poster ? (
                      <img src={film.data.banner ?? film.data.poster} alt="" loading="lazy" />
                    ) : <div class="image-placeholder" aria-hidden="true">CL</div>}
                  </div>
                  <h2>{film.data.title}</h2>
                  <p>{[film.data.format, film.data.duration ? `${film.data.duration} min` : null, film.data.year].filter(Boolean).join(' · ')}</p>
                </a>
              ))}
            </div>
          ) : <p class="empty-state">Nuestra filmografía estará disponible pronto.</p>}
        </section>
      </div>
    </div>
  </div>

  <script>
    const slides = [...document.querySelectorAll<HTMLElement>('[data-slide]')];
    let currentSlide = 0;

    function showSlide(index: number) {
      if (!slides.length) return;
      currentSlide = (index + slides.length) % slides.length;
      slides.forEach((slide, slideIndex) => {
        slide.classList.toggle('is-active', slideIndex === currentSlide);
        slide.setAttribute('aria-hidden', String(slideIndex !== currentSlide));
      });
    }

    document.querySelector('[data-carousel="previous"]')?.addEventListener('click', () => {
      showSlide(currentSlide - 1);
    });
    document.querySelector('[data-carousel="next"]')?.addEventListener('click', () => {
      showSlide(currentSlide + 1);
    });

    if (slides.length > 1) {
      window.setInterval(() => {
        if (document.hidden || document.querySelector<HTMLDialogElement>('[data-site-intro]')?.open) return;
        showSlide(currentSlide + 1);
      }, 5000);
    }

    const horizontal = document.querySelector<HTMLElement>('[data-home-horizontal]');
    const panels = [...(horizontal?.querySelectorAll<HTMLElement>('.home-hero-panel, .home-films') ?? [])];
    let frame = 0;

    function updateHorizontal() {
      frame = 0;
      if (!horizontal?.classList.contains('is-horizontal')) return;
      const distance = horizontal.offsetHeight - window.innerHeight;
      const progress = Math.min(1, Math.max(0, -horizontal.getBoundingClientRect().top / distance));
      // Reserve the first part of the gesture for a natural vertical scroll
      // through the hero, then begin the lateral move towards Films.
      const lateralStart = 0.28;
      const lateralProgress = Math.min(1, Math.max(0, (progress - lateralStart) / (1 - lateralStart)));
      horizontal.style.setProperty('--horizontal-offset', `${-lateralProgress * window.innerWidth * Math.max(0, panels.length - 1)}px`);
    }

    function requestHorizontalUpdate() {
      if (!frame) frame = requestAnimationFrame(updateHorizontal);
    }

    function configureHorizontal() {
      if (!horizontal) return;
      horizontal.classList.add('is-horizontal');
      requestHorizontalUpdate();
    }

    horizontal?.addEventListener('focusin', (event) => {
      if (!horizontal.classList.contains('is-horizontal')) return;
      const target = event.target;
      if (!(target instanceof Node)) return;
      const top = horizontal.getBoundingClientRect().top + window.scrollY;
      const panelIndex = panels.findIndex((panel) => panel.contains(target));
      const distance = horizontal.offsetHeight - window.innerHeight;
      window.scrollTo(0, top + (panelIndex > 0 ? distance : 0));
    });

    configureHorizontal();
    if (window.location.hash === '#films' && horizontal?.classList.contains('is-horizontal')) {
      window.scrollTo(0, horizontal.getBoundingClientRect().top + window.scrollY + horizontal.offsetHeight - window.innerHeight);
    }
    window.addEventListener('resize', configureHorizontal);
    window.addEventListener('scroll', requestHorizontalUpdate, { passive: true });
  </script>
</SiteLayout>
