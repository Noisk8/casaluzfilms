---
import { getCollection } from 'astro:content';
import SiteLayout from '../components/SiteLayout.astro';

const pages = await getCollection('pages');
const foundation = pages.find((page) => page.id === 'fundacion');
---

<SiteLayout title={foundation?.data.title ?? 'Fundación SerPUENTE'}>
  <article class="foundation-page">
    <figure class="foundation-logo">
      <img src="/images/logos/logo_fundacion.png" alt="Fundación SerPUENTE: Patrimonio, Cultura y Memoria Digital de la Amazonía" />
    </figure>
    <div class="foundation-copy">
      <h1>Fundación <span>SerPUENTE</span></h1>
      {foundation?.data.intro && <p>{foundation.data.intro}</p>}
      {foundation?.data.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      {foundation?.data.mission && (
        <section class="foundation-mission" aria-labelledby="mission-title">
          <h2 id="mission-title">Misión</h2>
          <p>{foundation.data.mission}</p>
        </section>
      )}
      {foundation?.data.instagramUrl && (
        <nav class="contact-socials" aria-label="Redes de Fundación SerPUENTE">
          <a href={foundation.data.instagramUrl} target="_blank" rel="noreferrer" aria-label="Fundación SerPUENTE en Instagram">
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.8" r="1" class="social-dot"/></svg>
          </a>
        </nav>
      )}
    </div>
  </article>
</SiteLayout>
