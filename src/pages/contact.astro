---
import { getCollection } from 'astro:content';
import SiteLayout from '../components/SiteLayout.astro';

const pages = await getCollection('pages');
const contact = pages.find((page) => page.id === 'contact');
---

<SiteLayout title={contact?.data.title ?? 'Contact'}>
  <section class="page-heading"><h1>{contact?.data.title ?? 'Contact'}</h1></section>
  <section class="contact-content">
    {contact?.data.intro && <p class="about-lead">{contact.data.intro}</p>}
    <address>
      {contact?.data.address && <p>{contact.data.address}</p>}
      {contact?.data.email && <p><a href={`mailto:${contact.data.email}`}>{contact.data.email}</a></p>}
      {contact?.data.phone && <p><a href={`tel:${contact.data.phone}`}>{contact.data.phone}</a></p>}
    </address>
    <nav class="contact-socials" aria-label="Perfiles de Casa Luz Films">
      <a href="https://www.imdb.com/es/search/title/?companies=co1121460" target="_blank" rel="noreferrer" aria-label="Casa Luz Films en IMDb">
        <svg viewBox="0 0 48 24" aria-hidden="true"><rect x="1" y="1" width="46" height="22" rx="2"/><path d="M8 7v10m4-10v10m4-10v10m5 0V7l4 10 4-10v10m5-10h6m-6 5h5m-5 5h6"/></svg>
      </a>
      <a href="https://www.instagram.com/casaluzfilms/" target="_blank" rel="noreferrer" aria-label="Casa Luz Films en Instagram">
        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.8" r="1" class="social-dot"/></svg>
      </a>
    </nav>
    {!contact && <p class="empty-state">Los datos de contacto se publicarán pronto.</p>}
  </section>
</SiteLayout>
